# App
APP_NAME=SaasChatbot
APP_ENV=development
DEBUG=true
SECRET_KEY=<genera-un-string-aleatorio-largo>

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL (solo desarrollo local — usa valores propios, no los subas a git)
POSTGRES_USER=saaschatbot
POSTGRES_PASSWORD=<tu-password-local>
POSTGRES_DB=saaschatbot
DATABASE_URL=postgresql+psycopg://saaschatbot:<tu-password-local>@localhost:5432/saaschatbot

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Trial defaults
TRIAL_BAIT_LIMIT=10
PAID_DAILY_BAIT_LIMIT=100
DEFAULT_PLAN_SLUG=pro

# Outbound / carnadas
BAIT_DELAY_MIN_SECONDS=45
BAIT_DELAY_MAX_SECONDS=120
OUTBOUND_WORKER_POLL_SECONDS=5.0

# Evolution API (legacy — solo si WHATSAPP_PROVIDER=evolution)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=dev-evolution-key-local
# DB de Evolution (misma credencial, base de datos "evolution")
EVOLUTION_DATABASE_URL=postgresql://saaschatbot:<tu-password-local>@localhost:5432/evolution
# Mac nativo: http://localhost:8000 | Docker: http://host.docker.internal:8000 + EVOLUTION_IN_DOCKER=true
APP_PUBLIC_URL=http://localhost:8000
EVOLUTION_IN_DOCKER=false
EVOLUTION_WEBHOOK_SECRET=dev-webhook-secret-local

# WAHA — WhatsApp HTTP API (Chrome real, recomendado)
# WAHA — Chrome real (requiere Docker). Sin Docker → WHATSAPP_PROVIDER=evolution
WHATSAPP_PROVIDER=evolution
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=dev-waha-key-local
WAHA_ENGINE=WEBJS
WAHA_DASHBOARD_PASSWORD=admin

# Chatwoot — OBLIGATORIO para sync (CHATWOOT_ENABLED=true sin token = sin mensajes)
CHATWOOT_ENABLED=true
CHATWOOT_URL=http://localhost:3000
CHATWOOT_PUBLIC_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=<token-admin-chatwoot-obligatorio>
CHATWOOT_SECRET_KEY_BASE=<genera-un-string-aleatorio-largo>
CHATWOOT_DAYS_LIMIT_IMPORT_MESSAGES=3
CHATWOOT_INBOX_MESSAGES_PER_CHAT=15
CHATWOOT_INBOX_MAX_CHATS_PER_SYNC=12
CHATWOOT_WEBHOOK_SECRET=dev-chatwoot-webhook-local

# DeepSeek IA — SOLO deepseek-chat (barato). No usar deepseek-reasoner ni v4-pro.
DEEPSEEK_API_KEY=<tu-api-key-deepseek>
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_CLASSIFIER_MODEL=deepseek-chat
# Clasificador por reglas locales (0 costo). true = usa LLM extra por mensaje ambiguo.
AI_CLASSIFIER_USE_LLM=false
AI_HISTORY_MESSAGES=10
AI_REPLY_MAX_TOKENS=350
AI_DEFAULT_MODE=qualify
AI_TRIAL_DAILY_CLASSIFY_LIMIT=500
# 0 = ilimitado en plan pagado (recomendado — clasificar es el core del producto)
AI_PAID_DAILY_CLASSIFY_LIMIT=0
AI_CLASSIFY_DELAY_SECONDS=0.3
AI_TRIAL_DAILY_REPLY_LIMIT=40
AI_PAID_DAILY_REPLY_LIMIT=400
AI_MAPS_PLANS_PER_DAY=5
AI_REPLY_DELAY_MIN_SECONDS=2
AI_REPLY_DELAY_MAX_SECONDS=6

# OAuth — login con Google / GitHub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback stays on the API port (register in Google Cloud Console).
# Session cookie is set via /auth/oauth/finish on the site origin (:4200 in dev).
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:4200/precios
OAUTH_ERROR_REDIRECT=http://localhost:4200/login

# Correo — magic link y recuperación de contraseña (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=Omitel <onboarding@resend.dev>
# SITE_PUBLIC_URL=http://localhost:4200
# PASSWORD_RESET_EXPIRE_MINUTES=30

# Wompi — pagos COP (Colombia)
# Sandbox: https://docs.wompi.co/docs/colombia/datos-de-prueba-en-sandbox/
# Dashboard → Developers → llaves (pub_test_, prv_test_, test_integrity_, test_events_)
# Webhook producción: POST {APP_PUBLIC_URL}/api/v1/billing/wompi/webhook
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxx
WOMPI_CHECKOUT_REDIRECT_URL=http://localhost:4200/precios
# Opcional — default auto (sandbox si pub_test_)
# WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

# Workers — desarrollo: true (todo en uvicorn). Producción: false + docker-compose.prod.yml
EMBED_WORKERS_IN_API=true
AI_MAX_PARALLEL_JOBS=20
AI_SLOT_WAIT_SECONDS=120
