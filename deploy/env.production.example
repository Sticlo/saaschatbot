# Plantilla del .env de producción. Copiar a la raíz del repo en el servidor como `.env`
# y llenar todos los valores. Nunca subir el .env real al repositorio.
# Generar secretos con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Dominios ───────────────────────────────────────────────────────────────
APP_DOMAIN=app.omitel.net
ACME_EMAIL=
APP_PUBLIC_URL=https://app.omitel.net
PANEL_PUBLIC_URL=https://app.omitel.net
SITE_PUBLIC_URL=https://www.omitel.net
# Orígenes extra con acceso a la API (el de SITE_PUBLIC_URL ya se incluye).
CORS_ORIGINS=https://omitel.net

# ── Secretos de la app ─────────────────────────────────────────────────────
SECRET_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_API_KEY=

# ── Base de datos ──────────────────────────────────────────────────────────
POSTGRES_USER=saaschatbot
POSTGRES_PASSWORD=
POSTGRES_DB=saaschatbot

# ── WhatsApp (Evolution) ───────────────────────────────────────────────────
# client_revision actual de https://web.whatsapp.com/sw.js, formato 2.3000.XXXXXXXXXX
CONFIG_SESSION_PHONE_VERSION=

# ── IA ─────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
AI_WORKER_THREADS=8
AI_MAX_PARALLEL_JOBS=20

# ── Login social (registrar estas URLs de callback en Google y GitHub) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.omitel.net/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://app.omitel.net/api/v1/auth/github/callback
OAUTH_SUCCESS_REDIRECT=https://www.omitel.net/precios
OAUTH_ERROR_REDIRECT=https://www.omitel.net/login

# ── Correo (Resend, con el dominio omitel.net verificado: SPF + DKIM) ──────
RESEND_API_KEY=
EMAIL_FROM=Omitel <hola@omitel.net>

# ── Pagos Wompi (llaves de producción) ─────────────────────────────────────
# URL de eventos a registrar en Wompi: https://app.omitel.net/api/v1/billing/wompi/webhook
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_CHECKOUT_REDIRECT_URL=https://www.omitel.net/precios
SUBSCRIPTION_GRACE_DAYS=3
TRIAL_DAYS=3

# ── Operación ──────────────────────────────────────────────────────────────
# Correos (separados por coma) con acceso a la consola de administración /panel/admin.html
PLATFORM_ADMIN_EMAILS=
# A dónde llegan las alertas de caídas (WhatsApp desconectado, colas atascadas, IA fallando)
OPS_ALERT_EMAIL=

# ── Respaldo fuera del servidor (opcional pero recomendado) ───────────────
# Cualquier almacenamiento compatible con S3: Cloudflare R2, DigitalOcean Spaces, Backblaze B2…
# Ej. R2: PROVIDER=Cloudflare, ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Clave para cifrar las copias. Guárdala también fuera del servidor (gestor de contraseñas):
# sin ella las copias externas no se pueden abrir.
BACKUP_ENCRYPTION_KEY=
